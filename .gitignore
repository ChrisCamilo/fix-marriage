logs/*
!logs/.gitignore

# Area de trabalho do arnes de regressao
logs/.regression/
testes.exe

# Quadros do video extraidos para inspecao: sao imagens da familia.
output/*.png
output/*.pgm
output/*.yuv
__pycache__/
