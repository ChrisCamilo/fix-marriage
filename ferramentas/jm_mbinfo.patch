diff --git a/source/app/ldecod/image.c b/source/app/ldecod/image.c
index 404e268..6a42957 100644
--- a/source/app/ldecod/image.c
+++ b/source/app/ldecod/image.c
@@ -2524,8 +2524,41 @@ void decode_one_slice(Slice *currSlice)
 
     // Initializes the current macroblock
     start_macroblock(currSlice, &currMB);
+    // fix-marriage: JM_MBINFO=<arquivo> grava uma linha por MB (tipo, modos
+    // intra 4x4, croma, cbp, qp e o estado do decodificador aritmetico no
+    // INICIO do MB). Nao muda nada da decodificacao.
+    int jm_pos = -1, jm_bl = 0; unsigned int jm_rng = 0, jm_val = 0;
+    {
+      DecodingEnvironment *jd = &currSlice->partArr[0].de_cabac;
+      if (jd->Dcodestrm_len) { jm_pos = *jd->Dcodestrm_len; jm_bl = jd->DbitsLeft; jm_rng = jd->Drange; jm_val = jd->Dvalue; }
+    }
+    /* contextos que a tarja usa, no INICIO do MB: estado*2+MPS. Ordem:
+     * mb_type I (11), delta_qp (4), croma (4), coded_block_flag do DC 16x16 (4) */
+    int jm_ctx[29], jm_nc = 0;
+    if (currSlice->mot_ctx && currSlice->tex_ctx) {
+      for (int k = 0; k < 11; k++) { BiContextType *c = &currSlice->mot_ctx->mb_type_contexts[0][k]; jm_ctx[jm_nc++] = c->state * 2 + c->MPS; }
+      for (int k = 0; k < 4; k++)  { BiContextType *c = &currSlice->mot_ctx->delta_qp_contexts[k];   jm_ctx[jm_nc++] = c->state * 2 + c->MPS; }
+      for (int k = 0; k < 4; k++)  { BiContextType *c = &currSlice->tex_ctx->cipr_contexts[k];       jm_ctx[jm_nc++] = c->state * 2 + c->MPS; }
+      for (int k = 0; k < 4; k++)  { BiContextType *c = &currSlice->tex_ctx->bcbp_contexts[0][k];    jm_ctx[jm_nc++] = c->state * 2 + c->MPS; }
+      /* skip de P (mb_type[1][0..2]) e de B (mb_type[2][7..9]) */
+      for (int k = 0; k < 3; k++)  { BiContextType *c = &currSlice->mot_ctx->mb_type_contexts[1][k];     jm_ctx[jm_nc++] = c->state * 2 + c->MPS; }
+      for (int k = 7; k < 10; k++) { BiContextType *c = &currSlice->mot_ctx->mb_type_contexts[2][k];     jm_ctx[jm_nc++] = c->state * 2 + c->MPS; }
+    }
     // Get the syntax elements from the NAL
     currSlice->read_one_macroblock(currMB);
+    {
+      static FILE *jm_f = NULL; static int jm_ini = 0;
+      if (!jm_ini) { const char *n = getenv("JM_MBINFO"); jm_ini = 1; if (n) jm_f = fopen(n, "w"); }
+      if (jm_f) {
+        fprintf(jm_f, "%d %d %d %d %d %d %d %d %u %u", currMB->mbAddrX, currMB->mb_type, currMB->i16mode,
+                currMB->c_ipred_mode, currMB->cbp, currMB->qp, jm_pos, jm_bl, jm_rng, jm_val);
+        for (int jj = 0; jj < 4; jj++) for (int ii = 0; ii < 4; ii++)
+          fprintf(jm_f, " %d", currSlice->ipredmode[currMB->block_y + jj][currMB->block_x + ii]);
+        fprintf(jm_f, " %d %d |", currSlice->slice_type, currMB->skip_flag);
+        for (int kk = 0; kk < jm_nc; kk++) fprintf(jm_f, " %d", jm_ctx[kk]);
+        fputc(10, jm_f); fflush(jm_f);
+      }
+    }
     decode_one_macroblock(currMB, currSlice->dec_picture);
 
     if(currSlice->mb_aff_frame_flag && currMB->mb_field)
